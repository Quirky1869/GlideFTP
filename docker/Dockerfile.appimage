FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# System dependencies for wails + webkit2gtk-4.1 + AppImage tooling
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    curl \
    wget \
    git \
    rsync \
    file \
    imagemagick \
    squashfs-tools \
    libwebkit2gtk-4.1-dev \
    libgtk-3-dev \
    && rm -rf /var/lib/apt/lists/*

# Node.js 20 (Ubuntu 22.04 ships Node 12 which is too old for wails frontend)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Go 1.25
ARG GO_VERSION=1.25.0
RUN curl -sSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" | \
    tar -xz -C /usr/local
ENV PATH="/usr/local/go/bin:/root/go/bin:${PATH}"
ENV GOPATH="/root/go"

# Wails CLI
RUN go install github.com/wailsapp/wails/v2/cmd/wails@latest

# linuxdeploy + appimage plugin — run via APPIMAGE_EXTRACT_AND_RUN=1 (no FUSE needed)
RUN wget -q -O /usr/local/bin/linuxdeploy \
      "https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage" && \
    wget -q -O /usr/local/bin/linuxdeploy-plugin-appimage \
      "https://github.com/linuxdeploy/linuxdeploy-plugin-appimage/releases/download/continuous/linuxdeploy-plugin-appimage-x86_64.AppImage" && \
    chmod +x /usr/local/bin/linuxdeploy /usr/local/bin/linuxdeploy-plugin-appimage

# Run AppImage tools without FUSE (extract-and-run into /tmp)
ENV APPIMAGE_EXTRACT_AND_RUN=1
ENV NO_STRIP=1
